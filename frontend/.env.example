# URL del backend Go (sin barra final), ej: https://tu-backend.up.railway.app
BACKEND_URL=

# Firebase (mismo proyecto que el backend, creado bajo tu cuenta)
API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# AWS S3 - SOLO server-side, usadas por src/app/api/upload/route.ts.
# IMPORTANTE: nunca prefijarlas con NEXT_PUBLIC_, eso las expone al navegador.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_S3_NAME=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# URL pública del propio frontend (para links de vuelta, ej: https://tu-app.vercel.app)
URL=
