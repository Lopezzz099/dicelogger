# URL del backend Go (sin barra final), ej: https://tu-backend.up.railway.app
BACKEND_URL=

# Firebase (mismo proyecto que el backend, creado bajo tu cuenta)
API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Cloudinary - usado por src/app/api/upload/route.ts (server-side, el
# navegador nunca ve estas credenciales). Sacalas de cloudinary.com,
# panel principal, arriba a la derecha ("Product Environment credentials").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# URL pública del propio frontend (para links de vuelta, ej: https://tu-app.vercel.app)
URL=
