# Base de datos MySQL
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=

# Puerto del servidor (Railway/Render/Fly lo inyectan solos; en local queda en 8080)
PORT=8080

# Firebase Auth — creá un proyecto nuevo en console.firebase.google.com bajo
# tu cuenta, generá una clave de cuenta de servicio (Configuración del
# proyecto -> Cuentas de servicio -> Generar nueva clave privada).
# En local: guardala como serviceAccountKey.json en la raíz del backend
# (nunca se sube a git) y dejá FIREBASE_CREDENTIALS_JSON vacío.
# En Railway/Render (sin filesystem persistente): pegá el contenido
# completo del .json en FIREBASE_CREDENTIALS_JSON en vez de usar un archivo.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_FILE=./serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON=

# Envío de emails: creá una cuenta de Gmail nueva (o usá una que ya tengas)
# y generá una "contraseña de aplicación" en myaccount.google.com/apppasswords
# - nunca uses la contraseña real de la cuenta acá.
EMAIL_SENDER=
EMAIL_APP_PASSWORD=

# AWS S3: creá un bucket nuevo en tu cuenta de AWS y un usuario IAM con
# permisos solo sobre ese bucket (s3:PutObject, s3:GetObject) - evitá
# usar credenciales de una cuenta root o con permisos amplios.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_NAME=
